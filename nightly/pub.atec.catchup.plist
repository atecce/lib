<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Make up nightly runs missed while the Mac was off (nightly/catchup.sh): at login, and hourly.
  Install: cp pub.atec.catchup.plist ~/Library/LaunchAgents/ &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pub.atec.catchup.plist
  Remove:  launchctl bootout gui/$(id -u)/pub.atec.catchup && rm ~/Library/LaunchAgents/pub.atec.catchup.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pub.atec.catchup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/atec/lib/nightly/catchup.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/atec/lib</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>StandardOutPath</key>
	<string>/Users/atec/Library/Logs/pub.atec.catchup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/atec/Library/Logs/pub.atec.catchup.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Cloudflare tunnel `lib`: cloudflared keeps an outgoing connection to Cloudflare, which
  sends it the requests for influx.atec.pub (InfluxDB, localhost:8181) and, once set up,
  grafana.atec.pub (localhost:3000). Nothing listens on the router; Cloudflare Access checks
  every request before it reaches the tunnel. The routes and Access rules live in the
  Cloudflare dashboard (Zero Trust); this only runs the connector, with the tunnel's token
  from ~/.cloudflared/lib-tunnel.token (not in git).
  Install: cp pub.atec.cloudflared.plist ~/Library/LaunchAgents/ &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pub.atec.cloudflared.plist
  Remove:  launchctl bootout gui/$(id -u)/pub.atec.cloudflared && rm ~/Library/LaunchAgents/pub.atec.cloudflared.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pub.atec.cloudflared</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/cloudflared</string>
		<string>tunnel</string>
		<string>--no-autoupdate</string>
		<string>run</string>
		<string>--token-file</string>
		<string>/Users/atec/.cloudflared/lib-tunnel.token</string>
	</array>
	<!-- Always on, and restarted if it exits. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/atec/.cloudflared/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/atec/.cloudflared/launchd.log</string>
</dict>
</plist>

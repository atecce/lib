          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date::timestamp AS \"time\", 'market cap' AS metric, market_cap AS value FROM market\nWHERE ticker = '${ticker:raw}' AND currency = CASE WHEN '${currency:raw}' = 'reporting' THEN coalesce(market_currency('${ticker:raw}'), reporting_currency('${ticker:raw}')) ELSE '${currency:raw}' END AND market_cap IS NOT NULL\nUNION ALL\nSELECT period_end::timestamp, 'book value (stockholders'' equity)', value\nFROM listing_facts('${ticker:raw}', 'pit', CASE WHEN '${currency:raw}' = 'reporting' THEN coalesce(market_currency('${ticker:raw}'), reporting_currency('${ticker:raw}')) ELSE '${currency:raw}' END, ARRAY['StockholdersEquity'])\nUNION ALL\nSELECT date::timestamp AS \"time\", 'price-to-book' AS metric, price_to_book AS value FROM market\nWHERE ticker = '${ticker:raw}' AND currency = CASE WHEN '${currency:raw}' = 'reporting' THEN coalesce(market_currency('${ticker:raw}'), reporting_currency('${ticker:raw}')) ELSE '${currency:raw}' END AND price_to_book IS NOT NULL\nORDER BY 1"

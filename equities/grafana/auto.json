        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "efm3zlbhro268a"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT \"value\" FROM \"reported_item_v15\" WHERE \"ticker\" =~ /^$ticker$/ AND \"item\" = 'Revenue' AND \"period\" = '$period' AND (\"currency\" = 'USD' AND \"ticker\" !~ /^(tm|race)$/ OR \"currency\" = 'JPY' OR \"currency\" = 'EUR') AND $timeFilter GROUP BY \"ticker\", \"currency\"",

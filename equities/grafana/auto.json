{
  "uid": "auto-industry",
  "title": "auto industry",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "description": "Car makers side by side: dollars on the left axis; yen (dashed) and euros (dotted) on the right. Companies follow equities/auto/all.txt.",
  "timezone": "utc",
  "graphTooltip": 1,
  "time": {
    "from": "now-12y",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "ticker",
        "label": "Companies",
        "query": "TSLA,F,TM,7203.T,RACE",
        "multi": true,
        "includeAll": false,
        "current": {
          "text": [
            "TSLA",
            "F",
            "TM",
            "7203.T",
            "RACE"
          ],
          "value": [
            "TSLA",
            "F",
            "TM",
            "7203.T",
            "RACE"
          ]
        },
        "options": [
          {
            "text": "TSLA",
            "value": "TSLA",
            "selected": true
          },
          {
            "text": "F",
            "value": "F",
            "selected": true
          },
          {
            "text": "TM",
            "value": "TM",
            "selected": true
          },
          {
            "text": "7203.T",
            "value": "7203.T",
            "selected": true
          },
          {
            "text": "RACE",
            "value": "RACE",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "type": "custom",
        "name": "period",
        "label": "Flows over",
        "query": "12m,3m",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "12m",
          "value": "12m"
        },
        "options": [
          {
            "text": "12m",
            "value": "12m",
            "selected": true
          },
          {
            "text": "3m",
            "value": "3m",
            "selected": false

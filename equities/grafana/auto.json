        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Revenue and profit (flows over $period)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Revenue",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "financials-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "financials-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT f.period_end::timestamp AS \"time\", upper(t.ticker) || ' ' || c.currency AS metric, f.value AS value\nFROM unnest(ARRAY[${ticker:singlequote}]) AS t(ticker)\nCROSS JOIN LATERAL (SELECT reporting_currency(upper(t.ticker)) AS currency) c\nCROSS JOIN LATERAL listing_facts(t.ticker, flow_period(upper(t.ticker), '${period:raw}'), c.currency, ARRAY['Revenue']) f\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*JPY.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "currencyJPY"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*EUR.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly EDGAR fetch and InfluxDB push of the Nikkei companies on EDGAR (run.sh), at 21:30, or on wake if the
  Mac was asleep then. For a checkout elsewhere, substitute its path:
  Install: sed "s|/Users/atec/lib|$LIB|g" pub.atec.equities.nikkei.plist > ~/Library/LaunchAgents/pub.atec.equities.nikkei.plist &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pub.atec.equities.nikkei.plist
  Run now: launchctl kickstart gui/$(id -u)/pub.atec.equities.nikkei
  Remove:  launchctl bootout gui/$(id -u)/pub.atec.equities.nikkei && rm ~/Library/LaunchAgents/pub.atec.equities.nikkei.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pub.atec.equities.nikkei</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-ims</string>
		<string>/Users/atec/lib/equities/nightly/run.sh</string>
		<string>equities/nikkei/all.txt</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/atec/lib</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/atec/lib/equities/nightly/launchd.nikkei.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/atec/lib/equities/nightly/launchd.nikkei.log</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>
</dict>
</plist>

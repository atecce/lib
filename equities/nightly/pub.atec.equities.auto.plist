<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly EDGAR fetch and InfluxDB push of the car makers (run.sh), at 21:45, or on wake if the
  Mac was asleep then. For a checkout elsewhere, substitute its path:
  Install: sed "s|/Users/atec/lib|$LIB|g" pub.atec.equities.auto.plist > ~/Library/LaunchAgents/pub.atec.equities.auto.plist &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pub.atec.equities.auto.plist
  Run now: launchctl kickstart gui/$(id -u)/pub.atec.equities.auto
  Remove:  launchctl bootout gui/$(id -u)/pub.atec.equities.auto && rm ~/Library/LaunchAgents/pub.atec.equities.auto.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pub.atec.equities.auto</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-ims</string>
		<string>/Users/atec/lib/equities/nightly/run.sh</string>
		<string>equities/auto/all.txt</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/atec/lib</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>45</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/atec/lib/equities/nightly/launchd.auto.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/atec/lib/equities/nightly/launchd.auto.log</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>
</dict>
</plist>

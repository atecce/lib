<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly EDINET fetch of every listed Japanese company (all.sh), at 23:30, or on wake if the Mac
  was asleep then. For a checkout elsewhere, substitute its path:
  Install: sed "s|/Users/atec/lib|$LIB|g" pub.atec.edinet.all.plist > ~/Library/LaunchAgents/pub.atec.edinet.all.plist &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pub.atec.edinet.all.plist
  Run now: launchctl kickstart gui/$(id -u)/pub.atec.edinet.all
  Remove:  launchctl bootout gui/$(id -u)/pub.atec.edinet.all && rm ~/Library/LaunchAgents/pub.atec.edinet.all.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>pub.atec.edinet.all</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-ims</string>
		<string>/Users/atec/lib/edinet/nightly/all.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/atec/lib</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>23</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/atec/lib/edinet/nightly/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/atec/lib/edinet/nightly/launchd.log</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>
</dict>
</plist>
